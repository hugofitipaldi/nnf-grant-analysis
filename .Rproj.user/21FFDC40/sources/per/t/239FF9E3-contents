## Longitudinal LS means over time

### Repeated measures mixed-effects model with post-hoc comparisons

A repeated measures mixed-effects analysis was performed to evaluate
the effects of treatments and time on the clinical scores. Pairwise
comparisons and compact letter displays (CLDs) are used to interpret
differences between treatment groups **at each time point**. Points
show LS means ± SE at each day. Different letters indicate significant
differences (P < 0.05) based on Tukey-adjusted pairwise comparisons;
† indicates a tendency (0.05 < P < 0.10).

### Abdominal score

```{r abd-longitudinal, message=FALSE, warning=FALSE, eval=TRUE, fig.width=18, fig.height=8}
fe_be_dep_mean_sd <- fe_be_dep %>%
  group_by(day_of_trial, treatment_full_name, variable_measured) %>%
  summarise(count = n(),
            mean = mean(as.numeric(variable_value), na.rm = TRUE),
            sd  = sd(as.numeric(variable_value),  na.rm = TRUE),
            .groups = "drop")

emm_bc      <- emmeans(model_abd, ~ treatment_full_name | day_of_trial)
pairwise_summary_bc <- summary(pairs(emm_bc))

ls_means_bc <- emm_bc %>%
  cld(Letters = letters, adjust = "tukey") %>%
  rename(cld = ".group") %>%
  mutate(cld = as.character(toupper(cld))) %>%
  select(treatment_full_name, day_of_trial, emmean, SE, cld) %>%
  mutate(emmean_round = round(emmean, 2))

for (i in 1:nrow(pairwise_summary_bc)) {
  if (pairwise_summary_bc$p.value[i] > 0.05 & pairwise_summary_bc$p.value[i] < 0.1) {
    day <- pairwise_summary_bc$day_of_trial[i]
    treatments <- strsplit(gsub(" - ", "|",
                                as.character(pairwise_summary_bc$contrast[i])), "\\|")[[1]]
    for (trt in treatments) {
      idx <- which(ls_means_bc$treatment_full_name == trt & ls_means_bc$day_of_trial == day)
      if (length(idx) > 0 && !grepl("\u2020", ls_means_bc$cld[idx]))
        ls_means_bc$cld[idx] <- paste0(ls_means_bc$cld[idx], "\u2020")
    }
  }
}
ls_means_bc$day_numeric <- as.numeric(as.character(ls_means_bc$day_of_trial))

ggplot(ls_means_bc, aes(x = day_numeric, y = emmean,
                         color = treatment_full_name, fill = treatment_full_name,
                         group = treatment_full_name)) +
  geom_ribbon(aes(ymin = emmean - SE, ymax = emmean + SE), alpha = 0.2, color = NA) +
  geom_line(linewidth = 1.2) +
  geom_point(size = 3, shape = 21, color = "black") +
  geom_text(aes(label = cld), vjust = -1, fontface = "bold", size = 4) +
  scale_color_manual(values = plotting_cols, name = "Treatment") +
  scale_fill_manual(values = plotting_cols, name = "Treatment") +
  scale_x_continuous(breaks = unique(ls_means_bc$day_numeric)) +
  labs(title = "Abdominal Scores Over Time (LS Means \u00b1 SE)",
       subtitle = "Different letters: P < 0.05 | \u2020 tendency (0.05 < P < 0.1)",
       x = "Day of Trial", y = "Abdominal Score (LS Mean \u00b1 SE)") +
  theme_minimal() +
  theme(plot.title = element_text(size = 16, face = "bold", hjust = 0.5),
        plot.subtitle = element_text(size = 11, hjust = 0.5, color = "gray40"),
        axis.text = element_text(size = 12),
        axis.title = element_text(size = 14, face = "bold"),
        legend.position = "bottom",
        panel.grid.major = element_line(color = "gray90"),
        panel.grid.minor = element_blank())
