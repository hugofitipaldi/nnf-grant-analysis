build_lsmean_row <- function(x, metric_name, t_labs) {
  period  <- sub("^(fi|bwg|fcr|gf|adfi|adg)_", "", metric_name)
  metric  <- sub("_.*$", "", metric_name)
  row_lab <- paste0(period_map[period], ": ", metric_map[metric])

  x <- x %>%
    mutate(Treatment_ID = factor(Treatment_ID, levels = t_labs)) %>%
    arrange(Treatment_ID)

  emmeans_fmt <- paste0(round(x$emmean, 1), " ", x$cld)
  out <- as.list(emmeans_fmt)
  names(out) <- as.character(x$Treatment_ID)
  out[["SEM"]]      <- as.character(round(x$SE[1], 2))
  out[["Treatment"]]  <- as.character(signif(x$p_value_Treatment_ID[1], 3))
  out[["Start weight"]] <- as.character(signif(x$p_value_start_weight[1], 3))

  if ("p_value" %in% names(x)) {
    pvals <- x %>% select(Treatment_ID, p_value) %>%
      mutate(Treatment_ID = as.character(Treatment_ID)) %>%
      filter(!is.na(p_value))
    if (nrow(pvals) > 0) {
      cont <- as.list(as.character(signif(pvals$p_value, 3)))
      names(cont) <- paste0("Cont: ", pvals$Treatment_ID)
      out <- c(out, cont)
    }
  }
  tibble(Variable = row_lab, !!!out)
}

