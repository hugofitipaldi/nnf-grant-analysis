## ---- dotplot function ----
dotplot_general <- function(data, gtitles, y_lab_title,
                            t_labs, plot_cols, dot_size,
                            cols_to_select, formula, tr_col,
                            y_var_col) {
  df <- data[, cols_to_select]
  df$Treatment_ID <- as.factor(fct_relevel(df[[tr_col]], t_labs))
  df$Value    <- df[[y_var_col]]

  df <- df %>%
    group_by(Treatment_ID) %>%
    filter(sum(!is.na(Value)) > 0) %>%
    ungroup() %>%
    mutate(Treatment_ID = droplevels(Treatment_ID))
  t_labs_use <- levels(df$Treatment_ID)

  mod <- lmer(formula, data = df, control = lmerControl(optimizer = "bobyqa"))

  dunnett_test  <- glht(mod, linfct = mcp(Treatment_ID = "Dunnett"))
  dunnett_summary <- summary(dunnett_test)
  p_values    <- dunnett_summary$test$pvalues
  names(p_values) <- rownames(dunnett_summary$test$coefficients)
  significant   <- p_values < 0.05

  letters.df <- rbind(
    data.frame(Treatment_ID = t_labs_use[1], p_value = NA,
               significant = NA, Letter = "a"),
    data.frame(Treatment_ID = t_labs_use[-1], p_value = p_values,
               significant = significant,
               Letter = if_else(significant, "b", "a"))
  ) %>%
    mutate(
      Letter = if_else((p_value > 0.05 & p_value < 0.1),
                       "\u2020", as.character(Letter)),
      Letter = if_else(Treatment_ID %in% t_labs_use[1], "a", as.character(Letter))
    )

  placement    <- matrix(NA, ncol = 2, nrow = length(t_labs_use))
  rownames(placement) <- t_labs_use
  placement[, 1]  <- t_labs_use
  colnames(placement) <- c("Treatment_ID", "Placement.Value")
  for (p in 1:length(t_labs_use)) {
    x <- df[which(df[, 1] %in% rownames(placement)[p]), ]
    placement[p, 2] <- quantile(x[, "Value"], na.rm = TRUE)[4]
  }
  placement      <- as.data.frame(placement)
  letters.df     <- left_join(letters.df, placement) %>%
    mutate(Placement.Value = as.numeric(Placement.Value),
           Letter = toupper(Letter))

  ggplot(df, aes(x = Treatment_ID, y = Value, fill = Treatment_ID)) +
    geom_boxplot(alpha = 0.5, outlier.shape = NA, color = "black") +
    geom_point(shape = 21, position = "jitter",
               size = dot_size, alpha = 0.7, color = "black") +
    labs(x = "", y = y_lab_title) +
    scale_x_discrete(labels = t_labs, drop = FALSE) +
    theme(axis.text.y = element_text(face = "bold", color = "black"),
          axis.text.x = element_blank(),
          legend.position = "bottom",
          legend.title.position = "top",
          legend.box = "horizontal") +
    {if (is.null(plot_cols))
      scale_fill_brewer(palette = "Spectral", name = "Treatment",
                        labels = t_labs, drop = FALSE)} +
    {if (!is.null(plot_cols))
      scale_fill_manual(values = plot_cols, name = "Treatment",
                        labels = t_labs, drop = TRUE)} +
    scale_y_continuous(breaks = pretty_breaks()) +
    {if (length(unique(letters.df$Letter)) > 1)
      geom_label(data = letters.df,
                 aes(x = Treatment_ID, y = Placement.Value, label = Letter),
                 size = 5, alpha = 0.5, color = "black", vjust = 0.5,
                 fontface = "bold", show.legend = FALSE, nudge_x = 0.3)} +
    ggtitle(gtitles)
}

## ---- ls-means function ----
ls_mean_tab_glht_general <- function(data, cols_to_select, y_var_col,
                                     tr_col, formula, t_labs) {
  df <- data[, cols_to_select]
  df$Treatment_ID <- as.factor(fct_relevel(df[[tr_col]], t_labs))
  df$Value    <- df[[y_var_col]]

  df <- df %>%
    group_by(Treatment_ID) %>%
    filter(sum(!is.na(Value)) > 0) %>%
    ungroup() %>%
    mutate(Treatment_ID = droplevels(Treatment_ID))
  t_labs_use <- levels(df$Treatment_ID)

  if (length(t_labs_use) < 2) {
    message("Skipping ", y_var_col, ": fewer than 2 treatments with valid data")
    return(NULL)
  }

  mod  <- lmer(formula, data = df, control = lmerControl(optimizer = "bobyqa"))
  df1  <- as.data.frame(emmeans(mod, "Treatment_ID"))

  dunnett_test  <- glht(mod, linfct = mcp(Treatment_ID = "Dunnett"))
  dunnett_summary <- summary(dunnett_test)
  p_values    <- dunnett_summary$test$pvalues
  names(p_values) <- rownames(dunnett_summary$test$coefficients)
  significant   <- p_values < 0.05

  df2 <- rbind(
    data.frame(Treatment_ID = t_labs_use[1], p_value = NA,
               significant = NA, Letter = "a"),
    data.frame(Treatment_ID = t_labs_use[-1], p_value = p_values,
               significant = significant,
               Letter = if_else(significant, "b", "a"))
  ) %>%
    mutate(
      Letter = if_else((p_value > 0.05 & p_value < 0.1),
                       "\u2020", as.character(Letter)),
      Letter = if_else(Treatment_ID %in% t_labs_use[1], "a", as.character(Letter)),
      Letter = toupper(Letter)
    )

  res <- cbind(df1, df2[, -1]) %>%
    mutate(
      Letter = if_else((p_value > 0.05 & p_value < 0.1), "\u2020",
                       as.character(Letter)),
      Letter = if_else(is.na(Letter), "A", as.character(Letter))
    )
  colnames(res)[c(5:6, 9)] <- c("lower_cl", "upper_cl", "cld")
  res[, "cld"] <- toupper(res[, "cld"])

  for (i in seq_along(rownames(Anova(mod)))) {
    res[[paste0("p_value_", rownames(Anova(mod))[i])]] <- Anova(mod)$"Pr(>Chisq)"[i]
  }
  return(res)
}

## ---- ls-means summary table function ----
ls_mean_sum_tab_general <- function(vars, t_labs, row_labs, round_levs,
                                    res_list, ff_p_val_cols,
                                    cont_p_val_col, ff_col_names) {
  res <- matrix(NA, nrow = length(vars),
                ncol = sum(c(length(t_labs) + 1,
                             length(ff_p_val_cols),
                             length(which(!is.na(res_list[[1]]$p_value))))))
  colnames(res) <- c(t_labs, "SEM", ff_col_names,
                     paste("Cont:", res_list[[1]]$Treatment_ID[!is.na(res_list[[1]]$p_value)]))
  rownames(res) <- row_labs

  for (i in 1:length(vars)) {
    if (length(unique(res_list[[i]][, "cld"])) == 1)
      res[i, 1:length(t_labs)] <- paste(round(res_list[[i]][, "emmean"], digits = round_levs[i]))
    else
      res[i, 1:length(t_labs)] <- paste(round(res_list[[i]][, "emmean"], digits = round_levs[i]),
                                         res_list[[i]][, "cld"], sep = " ")
    res[i, length(t_labs) + 1] <- round(res_list[[i]]$SE[2], digits = round_levs[i] + 1)
    res[i, ff_col_names] <- res_list[[i]] %>%
      select(ff_p_val_cols) %>% slice(1) %>% unlist() %>% round(digits = 3)
    res[i, which(!colnames(res) %in% c(t_labs, "SEM", ff_col_names))] <-
      res_list[[i]] %>% select(p_value) %>% pull() %>% na.omit() %>% round(3) %>% as.vector()
  }

  zero_idx <- which(res[, ] == "0", arr.ind = TRUE)
  if (nrow(zero_idx) > 0)
    for (j in 1:nrow(zero_idx))
      res[zero_idx[j, "row"], zero_idx[j, "col"]] <- "<0.001"
  return(res)
}

