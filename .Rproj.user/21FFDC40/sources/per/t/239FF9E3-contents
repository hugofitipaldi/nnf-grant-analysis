```{r ind-bw-dunnett, echo=FALSE, message=FALSE, warning=FALSE}
bw_dunnett_display_rich <- as.data.frame(bw_dunnett) %>%
  mutate(
    treatment = stringr::str_split_fixed(contrast, " - ", 2)[, 1],
    treatment = stringr::str_remove_all(treatment, "^\\(|\\)$"),
    treatment = stringr::str_squish(treatment),
    sig_class = case_when(
      p.value < 0.05 ~ "Significant (p<0.05)",
      p.value < 0.10 ~ "Tendency (p<0.10)",
      TRUE           ~ "NS"
    ),
    sig_symbol = case_when(
      p.value < 0.05 ~ "*",
      p.value < 0.10 ~ "\u2020",
      TRUE           ~ ""
    ),
    estimate_fmt = sprintf("%.3f %s", estimate, sig_symbol),
    p_fmt        = ifelse(is.na(p.value), NA_character_,
                          sprintf("%.3f", p.value))
  ) %>%
  select(day_num, treatment, estimate_fmt, SE, df, p_fmt, sig_class)

