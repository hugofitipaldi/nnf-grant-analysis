## Summary statistics table

Counts and proportions of observations per score category, treatment
group, and day of trial. These are derived from the raw data before
any modelling.

<br>

```{r fe-summary-table, message=FALSE, warning=FALSE, eval=TRUE}
ls_means_table <- function(model) {
  emm <- emmeans(model, ~ treatment_full_name | day_of_trial)
  pc_contrasts <- contrast(emm, method = "trt.vs.ctrl",
                           ref = "F18-ETEC (PC)", adjust = "dunnett")
  pairwise_summary_df <- as.data.frame(pc_contrasts) %>%
    separate(contrast, into = c("treatment_full_name", "control"), sep = " - ") %>%
    select(treatment_full_name, day_of_trial, p.value)

  ls_means <- as.data.frame(emm) %>%
    select(treatment_full_name, day_of_trial, emmean) %>%
    mutate(emmean = round(emmean, 1), cld = "A") %>%
    left_join(pairwise_summary_df, by = c("treatment_full_name", "day_of_trial")) %>%
    mutate(cld = case_when(
      !is.na(p.value) & p.value > 0.05 & p.value < 0.1 ~ "\u2020",
      !is.na(p.value) & p.value < 0.05           ~ "B",
      TRUE                           ~ cld
    )) %>%
    group_by(day_of_trial) %>%
    mutate(
      value = if (n_distinct(cld) == 1) {
        gsub(" ", "", paste(emmean))
      } else {
        gsub(" ", "", paste(emmean, cld))
      },
      value = sub("([0-9\\.]+)([A-Z\u2020]+)$", "\\1 \\2", value)
    ) %>%
    ungroup() %>%
    select(day_of_trial, treatment_full_name, value) %>%
    pivot_wider(names_from = treatment_full_name, values_from = value) %>%
    as.data.frame()
  return(ls_means)
}

