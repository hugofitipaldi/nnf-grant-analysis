trial_id <- "TRL_000411"

## ---- helper functions ----

load_excel_data <- function(file, sheet) {
  as.data.frame(readxl::read_excel(file, sheet = sheet))
}

find_and_replace_outliers <- function(data, outlier_cols) {
  data %>%
    mutate(across(all_of(outlier_cols), ~ ifelse(is_outlier(.), NA, .))) %>%
    ungroup()
}

datatable_func <- function(table) {
  datatable(
    table,
    options = list(
      scrollY  = 400, scrollX = TRUE,
      autoWidth = TRUE, paging = FALSE,
      dom = "t", ordering = FALSE
    ),
    rownames = FALSE, style = "bootstrap5",
    extensions = "Buttons"
  ) %>%
    formatStyle(columns = names(table), textAlign = "center")
}

txt_s <- 16
ts <- theme(
  axis.text.y  = element_text(angle = 0, size = txt_s),
  axis.title.y = element_text(size = txt_s),
  axis.title.x = element_text(size = txt_s),
  legend.text  = element_text(size = 12),
  title      = element_text(size = txt_s)
)

treatment_map <- c(
  "1-RED"   = "No Chall (NC)",
  "2-RED"   = "F18-ETEC (PC)",
  "3-BLUE"  = "1BP (BP-L)",
  "4-YELLOW" = "2BP (BP-SL)"
)

## ---- load sheets ----

treatment_group_metadata <- load_excel_data(file, "treatment_group_metadata") %>%
  arrange(pen) %>%
  mutate(
    template_ID      = trial_id,
    treatment_full_name = dplyr::recode(treatment_full_name, !!!treatment_map),
    treatment_full_name = factor(
      treatment_full_name,
      levels = c("F18-ETEC (PC)", "No Chall (NC)", "1BP (BP-L)", "2BP (BP-SL)")
    )
  )

trial_dates <- load_excel_data(file, "trial_dates") %>%
  mutate(date_of_measure = lubridate::ymd(date_of_measure), template_ID = trial_id)

feed_intake_exp_unit <- load_excel_data(file, "feed_intake_exp_unit") %>%
  mutate(date_of_measure = lubridate::ymd(date_of_measure), template_ID = trial_id)

body_weight_exp_unit <- load_excel_data(file, "body_weight_exp_unit") %>%
  mutate(date_of_measure = lubridate::ymd(date_of_measure), template_ID = trial_id)

animal_removals <- load_excel_data(file, "animal_removals") %>%
  mutate(date_of_measure = lubridate::ymd(date_of_measure), template_ID = trial_id)

## ---- joins ----

feed_intake_exp_unit <- feed_intake_exp_unit %>%
  left_join(select(trial_dates, date_of_measure, trial_period, day_of_trial),
            by = c("date_of_measure", "trial_period")) %>%
  left_join(select(treatment_group_metadata, pen, weight_block, room, treatment_full_name),
            by = "pen") %>%
  select(treatment_full_name, pen, weight_block, room,
         date_of_measure, day_of_trial, trial_period,
         days_on_feed, n_animal, pen_feed_intake)

body_weight_exp_unit <- body_weight_exp_unit %>%
  left_join(select(trial_dates, date_of_measure, trial_period, day_of_trial),
            by = c("date_of_measure", "trial_period")) %>%
  left_join(select(treatment_group_metadata, pen, weight_block, room, treatment_full_name),
            by = "pen") %>%
  select(treatment_full_name, pen, weight_block, room,
         date_of_measure, day_of_trial, trial_period,
         n_animal, pen_bodyweight)

feed_bw <- left_join(body_weight_exp_unit, feed_intake_exp_unit,
                     by = c("pen", "day_of_trial")) %>%
  select(treatment_full_name.x, pen, weight_block.x, room.x,
         date_of_measure.x, day_of_trial, trial_period.x,
         n_animal.x, pen_bodyweight, days_on_feed, pen_feed_intake) %>%
  rename(treatment_full_name = treatment_full_name.x,
         weight_block = weight_block.x,
         room = room.x,
         date_of_measure = date_of_measure.x,
         n_animal = n_animal.x,
         trial_period = trial_period.x) %>%
  filter(!is.na(pen_bodyweight)) %>%
  group_by(pen) %>%
  filter(n() >= 6) %>%
  ungroup()

animal_removals <- animal_removals %>%
  left_join(select(trial_dates, date_of_measure, day_of_trial, trial_period),
            by = "date_of_measure") %>%
  left_join(select(treatment_group_metadata, pen, weight_block, room, treatment_full_name),
            by = "pen") %>%
  select(treatment_full_name, pen, weight_block, room,
         date_of_measure, day_of_trial, trial_period,
         animal_id, mortality_cull_removal, reason, body_weight)

## ---- sanity check: removals on days not in schedule ----
removals_off_schedule <- animal_removals %>%
  filter(!day_of_trial %in% trial_dates$day_of_trial) %>%
  select(pen, animal_id, day_of_trial, mortality_cull_removal, reason)

if (nrow(removals_off_schedule) > 0) {
  message("WARNING: ", nrow(removals_off_schedule),
          " removals fall on days not in trial_dates")
  datatable_func(removals_off_schedule)
} else {
  message("All removal days match trial_dates schedule")
}

feed_bw <- feed_bw %>%
  left_join(
    animal_removals %>%
      group_by(pen, trial_period) %>%
      summarise(
        removal_weight = sum(body_weight, na.rm = TRUE),
        n_removals   = n(),
        n_mortality  = sum(mortality_cull_removal == "mortality", na.rm = TRUE),
        .groups    = "drop"
      ),
    by = c("pen", "trial_period")
  ) %>%
  mutate(
    removal_weight = ifelse(day_of_trial == 0, NA, removal_weight),
    n_removals   = ifelse(day_of_trial == 0, NA, n_removals),
    n_mortality  = ifelse(day_of_trial == 0, NA, n_mortality),
    n_mortality  = ifelse(n_mortality == 0, NA, n_mortality)
  ) %>%
  as.data.frame()

## ---- animal count integrity check ----

feed_selection <- feed_bw %>%
  filter(day_of_trial != 36) %>%
  select(pen, day_of_trial, trial_period, n_animal) %>%
  mutate(
    trial_period = ifelse(
      day_of_trial != 0,
      paste0("p", as.numeric(gsub("p", "", trial_period)) + 1),
      trial_period
    ),
    n_animal_prev = n_animal
  ) %>%
  select(pen, trial_period, n_animal_prev)

feed_bw_removal_check <- feed_bw %>%
  left_join(feed_selection, by = c("trial_period", "pen")) %>%
  mutate(
    n_removals   = ifelse(is.na(n_removals), 0, n_removals),
    issue_flag   = (n_animal + n_removals) == n_animal_prev,
    higher_or_less = case_when(
      n_animal_prev > n_animal ~ "higher",
      n_animal_prev < n_animal ~ "lower",
      TRUE           ~ "equal"
    )
  )

pen_problem_removals <- feed_bw_removal_check %>%
  filter(issue_flag == FALSE) %>%
  arrange(pen) %>%
  select(treatment_full_name, pen, day_of_trial, trial_period,
         n_animal, n_removals, n_animal_prev)

if (nrow(pen_problem_removals) > 0) {
  message("WARNING: ", nrow(pen_problem_removals),
          " pen-period combinations have animal count discrepancies")
  datatable_func(pen_problem_removals)
} else {
  message("Animal count checks passed for all pens and periods")
}
