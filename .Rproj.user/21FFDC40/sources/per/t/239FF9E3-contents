## Calculated performance metrics

```{r perf-calc, message=FALSE, warning=FALSE, eval=TRUE}
periods <- data.frame(
  trial_period = c(
    "0_8", "8_15", "15_22", "22_29", "29_36",
    "0_15", "0_22", "0_29", "0_36",
    "8_22", "8_29", "8_36"
  ),
  first_period = c(
    0, 8, 15, 22, 29,
    0, 0, 0, 0,
    8, 8, 8
  ),
  second_period = c(
    8, 15, 22, 29, 36,
    15, 22, 29, 36,
    22, 29, 36
  ),
  trial_period_label = c(
    "Day 0-8", "Day 8-15", "Day 15-22", "Day 22-29", "Day 29-36",
    "Day 0-15", "Day 0-22", "Day 0-29", "Day 0-36",
    "Day 8-22", "Day 8-29", "Day 8-36"
  ),
  stringsAsFactors = FALSE
)

trial_period_labs <- periods$trial_period_label
trial_col_labs  <- periods$trial_period

feed_bw <- feed_bw %>%
  group_by(pen, day_of_trial) %>%
  mutate(bw_av = pen_bodyweight / n_animal) %>%
  ungroup() %>%
  left_join(periods, by = "trial_period") %>%
  mutate(first_period = as.numeric(first_period),
         second_period = as.numeric(second_period)) %>%
  as.data.frame()

pens_df <- unique(feed_bw[, c("treatment_full_name", "pen", "weight_block", "room")])
per_dat <- tidyr::crossing(pens_df, periods) %>%
  mutate(
    fi = NA, bwg = NA, fcr = NA, gf = NA,
    adfi = NA, adg = NA,
    days_on_feed = NA, raw_fi = NA,
    bw_first_period = NA, bw_second_period = NA, removal_weight = NA
  )

per_dat$first_period  <- as.numeric(per_dat$first_period)
per_dat$second_period <- as.numeric(per_dat$second_period)

## ---- main performance loop ----
for (i in 1:nrow(per_dat)) {

  first_row <- match(
    paste(per_dat$pen[i], per_dat$first_period[i]),
    paste(feed_bw$pen, feed_bw$day_of_trial)
  )
  second_row <- match(
    paste(per_dat$pen[i], per_dat$second_period[i]),
    paste(feed_bw$pen, feed_bw$day_of_trial)
  )

  days   <- seq(feed_bw[first_row, "day_of_trial"],
                feed_bw[second_row, "day_of_trial"], 1)
  f_days  <- length(days) - 1

  animal_removals_day <- animal_removals[
    which(animal_removals$pen %in% feed_bw[first_row, "pen"] &
            animal_removals$day_of_trial %in% days), ]

  if (nrow(animal_removals_day) == 0) {
    days_on_feed <- feed_bw[second_row, "n_animal"] * f_days
  } else {
    p_days_on_feed <- feed_bw[second_row, "n_animal"] * f_days
    add_days <- vapply(seq_len(nrow(animal_removals_day)), function(j) {
      which(days %in% animal_removals_day[j, "day_of_trial"]) - 1
    }, numeric(1))
    days_on_feed <- sum(p_days_on_feed, sum(add_days))
  }

  per_dat$days_on_feed[i]   <- as.numeric(days_on_feed)
  per_dat$bw_first_period[i] <- feed_bw[first_row, "pen_bodyweight"]
  per_dat$bw_second_period[i] <- feed_bw[second_row, "pen_bodyweight"]
  per_dat$removal_weight[i]  <- feed_bw[second_row, "removal_weight"]

  per_dat$bwg[i] <- feed_bw[second_row, "bw_av"] - feed_bw[first_row, "bw_av"]

  bwg <- sum(feed_bw[second_row, "pen_bodyweight"],
             feed_bw[second_row, "removal_weight"], na.rm = TRUE) -
    feed_bw[first_row, "pen_bodyweight"]

  raw_fi <- as.numeric(feed_bw[second_row, "pen_feed_intake"])

  per_dat$adg[i]  <- bwg / days_on_feed
  ## FCR: retain all values including negatives — they are biologically real
  ## in a challenge model and are explained in context.
  per_dat$fcr[i]  <- if_else(raw_fi <= 0, NA_real_, raw_fi / bwg)
  ## GF = inverse of FCR; interpretable when BWG < 0 (negative GF = weight loss)
  per_dat$gf[i]   <- if_else(raw_fi <= 0, NA_real_, bwg / raw_fi)
  per_dat$fi[i]   <- raw_fi
  per_dat$adfi[i] <- raw_fi / days_on_feed
}

per_dat <- per_dat[, c(
  "treatment_full_name", "pen", "weight_block", "room",
  "trial_period", "trial_period_label", "first_period", "second_period",
  "fi", "bwg", "fcr", "gf", "adfi", "adg"
)]
per_dat <- per_dat[!duplicated(per_dat), ]

per_dat_long <- as.data.frame(pivot_longer(
  per_dat,
  cols = c("fi", "bwg", "fcr", "gf", "adfi", "adg")
))

per_dat_long$name <- fct_relevel(per_dat_long$name,
                                  c("fi", "bwg", "fcr", "gf", "adfi", "adg"))
per_dat_long$trial_period_label <-
  fct_relevel(per_dat_long$trial_period_label, trial_period_labs)
per_dat_long <- per_dat_long %>%
  mutate(value = if_else(name == "adg", value * 1000, value))

plotting_cols <- brewer.pal(
  length(levels(per_dat_long$treatment_full_name)), "Spectral"
)
names(plotting_cols) <- levels(per_dat_long$treatment_full_name)

## workbooks
